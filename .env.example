# Server-Port (Produktion). Im Dev-Modus nutzt das Backend 3001, Vite 5173.
PORT=3000

# Optional: Login-Felder vorausfüllen
# PROXMOX_URL=https://192.168.1.10:8006
# PROXMOX_USER=root
# PROXMOX_REALM=pam

# Optional: API-Token statt Passwort (Proxmox → Datacenter → Permissions → API Tokens)
# PROXMOX_TOKEN_ID=root@pam!proxpanel
# PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Self-Signed-Zertifikate von Proxmox akzeptieren (Standard: true)
# PROXMOX_INSECURE_TLS=true
