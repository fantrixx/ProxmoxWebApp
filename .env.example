# Server port (production). In dev mode the backend uses 3001, Vite uses 5173.
PORT=3000

# Optional: pre-fill login fields
# PROXMOX_URL=https://192.168.1.10:8006
# PROXMOX_USER=root
# PROXMOX_REALM=pam

# Optional: API token instead of password (Proxmox → Datacenter → Permissions → API Tokens)
# PROXMOX_TOKEN_ID=root@pam!proxpanel
# PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Accept Proxmox self-signed certificates (default: true)
# PROXMOX_INSECURE_TLS=true
